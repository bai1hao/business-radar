{
  "name": "deeppoint-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local.ps1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "python:check": "python -m compileall lib",
    "backup:data": "node scripts/backup-data.mjs",
    "backfill:comment-time": "node scripts/backfill-comment-time.mjs",
    "backfill:source-keyword": "python scripts/backfill-source-keyword.py",
    "import:data": "node scripts/import-backup.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run python:check"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "lucide-react": "^0.562.0",
    "next": "^15.5.29",
    "next-intl": "^4.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
