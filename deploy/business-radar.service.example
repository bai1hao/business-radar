[Unit]
Description=Business Radar web application
After=network.target

[Service]
Type=simple
User=business-radar
WorkingDirectory=/opt/business-radar/app
EnvironmentFile=/etc/business-radar.env
Environment=NODE_ENV=production
Environment=BUSINESS_RADAR_WEB_ONLY=true
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/business-radar /opt/business-radar/app/.next/cache

[Install]
WantedBy=multi-user.target
